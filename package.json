{
  "name": "@clikdeploy/clikcode",
  "version": "1.0.0",
  "description": "ClikCode local-first coding-agent harness",
  "type": "module",
  "bin": { "clikcode": "./dist/index.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --target=node22 --banner:js='#!/usr/bin/env node' --outfile=dist/index.js && esbuild ../cli/src/ai-router-runtime.ts --bundle --platform=node --format=cjs --target=node22 --external:@basetenlabs/performance-client --outfile=dist/ai-router-runtime.cjs",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && node dist/index.js --help && node dist/index.js --human doctor"
  },
  "dependencies": {
    "@clikdeploy/clikrouter": "file:../../packages/clikrouter",
    "@basetenlabs/performance-client": "0.0.10",
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "inquirer": "^14.0.2",
    "ora": "^9.4.1",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.28.1",
    "typescript": "catalog:"
  },
  "engines": { "node": ">=22.12.0" },
  "license": "MIT"
}
