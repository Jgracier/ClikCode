{
  "name": "@clikcode/router",
  "version": "0.1.0",
  "private": true,
  "description": "ClikCode's harness catalog, the provider registry for its direct API-key route, and the AI SDK turn that serves that route.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "//exports": [
    "Consumed AS SOURCE (no build step). `main` alone left SUBPATHS unresolvable by Node",
    "(`@clikcode/router/ai-provider-registry`), which surfaced only in vitest, as a silent",
    "COLLECTION failure. `./*` -> `./src/*.ts` mirrors the tsconfig `paths` entry so the",
    "two resolvers agree by construction."
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.27",
    "@ai-sdk/azure": "^4.0.28",
    "@ai-sdk/baseten": "^2.0.20",
    "@ai-sdk/cerebras": "^3.0.20",
    "@ai-sdk/cohere": "^4.0.18",
    "@ai-sdk/deepseek": "^3.0.19",
    "@ai-sdk/fireworks": "^3.0.22",
    "@ai-sdk/groq": "^4.0.19",
    "@ai-sdk/mistral": "^4.0.20",
    "@ai-sdk/openai": "^4.0.27",
    "@ai-sdk/openai-compatible": "^3.0.20",
    "@ai-sdk/perplexity": "^4.0.20",
    "@ai-sdk/togetherai": "^3.0.21",
    "@ai-sdk/xai": "^4.0.25",
    "ai": "^7.0.48"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
