{
  "name": "clikcode",
  "displayName": "ClikCode",
  "description": "Claude Code, Codex, Gemini, Copilot, OpenCode and 20 more coding agents in one chat: pick any provider and model from the composer, resume the same conversations as the terminal, switch accounts automatically when a usage limit hits, and review every change as a diff.",
  "//version": "MAJOR.MINOR only: ClikDeploy computes the patch and stamps the full version into its own build copy before publishing, so the patch digit here is ignored. Bump the minor (or major) here for a new release line; never the patch. Versioned independently of the clikcode npm package.",
  "version": "0.2.0",
  "publisher": "clikcode",
  "license": "MIT",
  "pricing": "Free",
  "qna": "https://github.com/Jgracier/ClikCode/issues",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#16181d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jgracier/ClikCode.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/Jgracier/ClikCode/tree/main/packages/vscode#readme",
  "bugs": {
    "url": "https://github.com/Jgracier/ClikCode/issues"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "clikcode",
    "claude code",
    "claude",
    "codex",
    "gemini",
    "copilot",
    "opencode",
    "qwen",
    "cursor agent",
    "ai agent",
    "coding agent",
    "multi-agent",
    "ai",
    "chat",
    "coding assistant",
    "llm",
    "anthropic",
    "openai",
    "account switching",
    "usage limits"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "ClikCode runs coding agents that read and change files and run commands in the workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clikcode",
          "title": "ClikCode",
          "icon": "media/activity.svg",
          "when": "clikcode.doesNotSupportSecondarySidebar"
        }
      ],
      "secondarySidebar": [
        {
          "id": "clikcode-secondary",
          "title": "ClikCode",
          "icon": "media/activity.svg",
          "when": "!clikcode.doesNotSupportSecondarySidebar"
        }
      ]
    },
    "views": {
      "clikcode": [
        {
          "type": "webview",
          "id": "clikcode.chat",
          "name": "ClikCode",
          "icon": "media/activity.svg",
          "contextualTitle": "ClikCode",
          "when": "clikcode.doesNotSupportSecondarySidebar"
        }
      ],
      "clikcode-secondary": [
        {
          "type": "webview",
          "id": "clikcode.chatSecondary",
          "name": "ClikCode",
          "icon": "media/activity.svg",
          "contextualTitle": "ClikCode",
          "when": "!clikcode.doesNotSupportSecondarySidebar"
        }
      ]
    },
    "commands": [
      {
        "command": "clikcode.open",
        "title": "Open ClikCode",
        "category": "ClikCode",
        "icon": {
          "light": "media/editor-light.svg",
          "dark": "media/editor-dark.svg"
        }
      },
      {
        "command": "clikcode.openInSideBar",
        "title": "Open in Side Bar",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.openInNewTab",
        "title": "Open in New Tab",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.openInNewWindow",
        "title": "Open in New Window",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.openInEditor",
        "title": "Open Chat in Editor",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.focus",
        "title": "Focus Chat Input",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.blur",
        "title": "Focus Editor",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.newChat",
        "title": "New Chat",
        "category": "ClikCode",
        "icon": "$(add)"
      },
      {
        "command": "clikcode.showHistory",
        "title": "Show Conversations",
        "category": "ClikCode",
        "icon": "$(history)"
      },
      {
        "command": "clikcode.resumeChat",
        "title": "Resume Chat…",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.showAccounts",
        "title": "Accounts and Usage",
        "category": "ClikCode",
        "icon": "$(account)"
      },
      {
        "command": "clikcode.openSettings",
        "title": "Chat Settings",
        "category": "ClikCode",
        "icon": "$(settings-gear)"
      },
      {
        "command": "clikcode.chooseProvider",
        "title": "Choose Provider…",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.chooseModel",
        "title": "Choose Model…",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.chooseAccount",
        "title": "Choose Account…",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.chooseEffort",
        "title": "Choose Reasoning Effort…",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.choosePermissions",
        "title": "Choose Permissions…",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.runSlashCommand",
        "title": "Run Slash Command…",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.addToChat",
        "title": "Add to ClikCode Chat",
        "category": "ClikCode",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "clikcode.insertAtMention",
        "title": "Insert @-Mention of Selection",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.askAboutSelection",
        "title": "Ask About Selection",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.attachFile",
        "title": "Attach File to Chat",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.acceptProposedDiff",
        "title": "Accept Proposed Change",
        "category": "ClikCode",
        "icon": "$(check)"
      },
      {
        "command": "clikcode.rejectProposedDiff",
        "title": "Reject Proposed Change",
        "category": "ClikCode",
        "icon": "$(discard)"
      },
      {
        "command": "clikcode.cancel",
        "title": "Stop the Running Turn",
        "category": "ClikCode",
        "icon": "$(debug-stop)"
      },
      {
        "command": "clikcode.restart",
        "title": "Restart Connection",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.showLog",
        "title": "Show Log",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.install",
        "title": "Install ClikCode",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.update",
        "title": "Update ClikCode",
        "category": "ClikCode"
      },
      {
        "command": "clikcode.updateExtension",
        "title": "Update Extension",
        "category": "ClikCode"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "clikcode.acceptProposedDiff",
          "when": "resourceScheme == clikcode-diff",
          "group": "navigation@1"
        },
        {
          "command": "clikcode.rejectProposedDiff",
          "when": "resourceScheme == clikcode-diff",
          "group": "navigation@2"
        },
        {
          "command": "clikcode.open",
          "when": "resourceScheme != clikcode-diff",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "clikcode.addToChat",
          "when": "resourceScheme == file || resourceScheme == untitled",
          "group": "clikcode@1"
        },
        {
          "command": "clikcode.askAboutSelection",
          "when": "editorHasSelection",
          "group": "clikcode@2"
        },
        {
          "command": "clikcode.acceptProposedDiff",
          "when": "resourceScheme == clikcode-diff",
          "group": "clikcode@1"
        },
        {
          "command": "clikcode.rejectProposedDiff",
          "when": "resourceScheme == clikcode-diff",
          "group": "clikcode@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "clikcode.addToChat",
          "when": "resourceScheme == file",
          "group": "clikcode@1"
        }
      ],
      "explorer/context": [
        {
          "command": "clikcode.addToChat",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "clikcode@1"
        }
      ],
      "commandPalette": [
        {
          "command": "clikcode.acceptProposedDiff",
          "when": "resourceScheme == clikcode-diff"
        },
        {
          "command": "clikcode.rejectProposedDiff",
          "when": "resourceScheme == clikcode-diff"
        },
        {
          "command": "clikcode.blur",
          "when": "false"
        },
        {
          "command": "clikcode.openInEditor",
          "when": "false"
        },
        {
          "command": "clikcode.attachFile",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "clikcode.focus",
        "key": "ctrl+escape",
        "mac": "cmd+escape",
        "when": "editorTextFocus"
      },
      {
        "command": "clikcode.focus",
        "key": "ctrl+alt+c",
        "mac": "ctrl+cmd+c"
      },
      {
        "command": "clikcode.blur",
        "key": "ctrl+escape",
        "mac": "cmd+escape",
        "when": "!editorTextFocus && (focusedView == clikcode.chat || focusedView == clikcode.chatSecondary || activeWebviewPanelId == clikcode.chatEditor)"
      },
      {
        "command": "clikcode.openInNewTab",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape"
      },
      {
        "command": "clikcode.insertAtMention",
        "key": "alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "clikcode.newChat",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "(focusedView == clikcode.chat || focusedView == clikcode.chatSecondary || activeWebviewPanelId == clikcode.chatEditor)"
      },
      {
        "command": "clikcode.askAboutSelection",
        "key": "ctrl+alt+q",
        "mac": "ctrl+cmd+q",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "clikcode.cancel",
        "key": "escape",
        "when": "(focusedView == clikcode.chat || focusedView == clikcode.chatSecondary || activeWebviewPanelId == clikcode.chatEditor) && clikcode.turnRunning"
      }
    ],
    "configuration": {
      "title": "ClikCode",
      "properties": {
        "clikcode.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the `clikcode` executable or its `dist/index.js`. Empty: found on `PATH`. Install ClikCode with `npm install -g clikcode@latest` (or, without the npm registry, `npm install -g https://github.com/Jgracier/ClikCode/releases/latest/download/clikcode.tgz`)."
        },
        "clikcode.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Node.js 22.12 or newer to run ClikCode with. Empty: `node` on `PATH`, then the Node.js built into VS Code when it is new enough."
        },
        "clikcode.openDiffOnApproval": {
          "type": "boolean",
          "default": true,
          "description": "Open the proposed change in a diff editor when an approval request carries one."
        },
        "clikcode.startWith": {
          "type": "string",
          "enum": [
            "continue",
            "new"
          ],
          "enumDescriptions": [
            "Continue this workspace's most recent chat.",
            "Start a new chat."
          ],
          "default": "continue",
          "description": "What the chat shows when it opens."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "clikcode.start",
        "title": "Get started with ClikCode",
        "description": "Every coding agent in one chat: choose a provider, sign in, and work with the same conversations as the terminal.",
        "steps": [
          {
            "id": "open",
            "title": "Open the chat",
            "description": "ClikCode lives in the secondary side bar, on the right. Open it from the ClikCode button at the top right of any editor, or press Ctrl+Esc (Cmd+Esc on macOS).\n[Open ClikCode](command:clikcode.open)",
            "media": {
              "image": "media/screenshots/welcome.png",
              "altText": "The ClikCode chat in the secondary side bar"
            },
            "completionEvents": [
              "onCommand:clikcode.open"
            ]
          },
          {
            "id": "provider",
            "title": "Pick a provider and model",
            "description": "The provider·model button under the message box lists all 25 harnesses, ClikDeploy Gateway and ClikCode Local, with their models. A harness that is not installed installs when you choose it.\n[Open the chat](command:clikcode.focus)",
            "media": {
              "image": "media/screenshots/picker.png",
              "altText": "The provider and model menu"
            }
          },
          {
            "id": "accounts",
            "title": "Sign in and add accounts",
            "description": "Add several accounts per provider. When one hits its usage limit, ClikCode moves the chat to the next automatically. Usage meters show each account's 5-hour and weekly windows.\n[Accounts and usage](command:clikcode.showAccounts)",
            "media": {
              "image": "media/screenshots/accounts.png",
              "altText": "Accounts and usage"
            },
            "completionEvents": [
              "onCommand:clikcode.showAccounts"
            ]
          },
          {
            "id": "context",
            "title": "Add code to the chat",
            "description": "Type @ to mention a file, press Alt+K in an editor to add the selection, or right-click a file and choose Add to ClikCode Chat.\n[Add the current file](command:clikcode.addToChat)",
            "media": {
              "image": "media/screenshots/turn.png",
              "altText": "A turn with tool activity"
            }
          },
          {
            "id": "history",
            "title": "Resume any conversation",
            "description": "Conversations are shared with the clikcode terminal: resume one here, or continue it in the terminal.\n[Show conversations](command:clikcode.showHistory)",
            "media": {
              "image": "media/screenshots/history.png",
              "altText": "The conversation list"
            },
            "completionEvents": [
              "onCommand:clikcode.showHistory"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:production": "node scripts/build.mjs --production",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "node scripts/build.mjs --tests && node out/test/integration/run.js",
    "package": "node scripts/package.mjs",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "26.1.2",
    "@types/vscode": "1.99.0",
    "@vscode/codicons": "0.0.36",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.1",
    "marked": "15.0.12",
    "mocha": "12.0.2",
    "ovsx": "1.2.0",
    "preact": "10.29.8",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
